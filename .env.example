# ============================================================
# EasyParcel Manual Order Integration - Developer Hub Open API
# Backend only. Never place Client Secret / tokens in React .env.
# Manual order EasyParcel booking is limited to MY domestic and SG domestic.
# ============================================================
EASYPARCEL_MODE=sandbox
EASYPARCEL_TIMEOUT_MS=20000
EASYPARCEL_API_BASE_URL=https://api.easyparcel.com
EASYPARCEL_OPEN_API_VERSION=2026-03

# Optional override. Official Open API docs currently use /shipment/submit_orders for submit.
# EASYPARCEL_SUBMIT_PATH=/shipment/submit_orders
# Optional override for tracking if EasyParcel changes the Developer Hub endpoint.
# EASYPARCEL_TRACKING_PATH=/open_api/2026-03/shipment/trackings

# Stripe hosted Checkout for subscription payments.
# Use a test key while validating, then replace with the live secret key in production.
STRIPE_SECRET_KEY=sk_test_*****
FRONTEND_URL=http://localhost:5173

# Manual Order shipping wallet FX
# Live top-up conversion uses MANUAL_ORDER_SHIPPING_FX_API_BASE_URL/{CURRENCY} and adds this margin to non-MYR rates.
MANUAL_ORDER_SHIPPING_FX_API_BASE_URL=https://open.er-api.com/v6/latest
MANUAL_ORDER_SHIPPING_FX_MARGIN_TO_MYR=0.01
MANUAL_ORDER_SHIPPING_FX_TIMEOUT_MS=5000
MANUAL_ORDER_SHIPPING_FX_CACHE_TTL_MS=600000
MANUAL_ORDER_SHIPPING_TOPUP_FEE_PERCENT=0.06
MANUAL_ORDER_SHIPPING_TOPUP_FEE_FIXED_MYR=1
MANUAL_ORDER_SHIPPING_BOOKING_MARGIN_MYR=1
MANUAL_ORDER_SHIPPING_BOOKING_MARGIN_RATE=0.05

# Comma-separated ERP user emails allowed to call /api/v1/admin/* routes.
# The user must also be logged in with owner/admin role.
ADMIN_MANAGEMENT_EMAILS=admin@example.com

# Optional API key for /api/v1/platform-order-activity/activity-logs.
# Leave empty to allow webhook log posts without a key.
ORDER_WEBHOOK_API_KEY=

# Malaysia Developer Hub app credentials and connected account tokens
EASYPARCEL_MY_CLIENT_ID=*****
EASYPARCEL_MY_CLIENT_SECRET=*****
EASYPARCEL_MY_REDIRECT_URI="*****"
EASYPARCEL_MY_ACCESS_TOKEN="*****"
EASYPARCEL_MY_REFRESH_TOKEN="*****"
EASYPARCEL_MY_TOKEN_EXPIRES_AT=""
EASYPARCEL_MY_SENDER_EMAIL="*****"

# Singapore Developer Hub app credentials and connected account tokens
EASYPARCEL_SG_CLIENT_ID=*****
EASYPARCEL_SG_CLIENT_SECRET=*****
EASYPARCEL_SG_REDIRECT_URI=*****
EASYPARCEL_SG_ACCESS_TOKEN=*****
EASYPARCEL_SG_REFRESH_TOKEN=*****
EASYPARCEL_SG_TOKEN_EXPIRES_AT=
EASYPARCEL_SG_SENDER_EMAIL=*****

# Optional IIS log cleanup.
# Set IIS_LOG_CLEANUP_DIR to this project's IIS site folder, for example:
# C:\inetpub\logs\LogFiles\W3SVC1
IIS_LOG_CLEANUP_ENABLED=false
IIS_LOG_CLEANUP_DIR=C:\inetpub\logs\LogFiles
IIS_LOG_RETENTION_DAYS=15
IIS_LOG_CLEANUP_INTERVAL_MS=86400000
IIS_LOG_CLEANUP_RUN_ON_START=true
IIS_LOG_CLEANUP_DRY_RUN=false
