# ============================================================
# EasyParcel Manual Order Integration - Developer Hub Open API
# Backend only. Never place Client Secret / tokens in React .env.
# Manual order EasyParcel booking is limited to MY domestic and SG domestic.
# ============================================================
EASYPARCEL_MODE=sandbox
EASYPARCEL_TIMEOUT_MS=20000
EASYPARCEL_API_BASE_URL=https://api.easyparcel.com
EASYPARCEL_OPEN_API_VERSION=2026-03

# Optional override. Official Open API docs currently use /shipment/submit_orders for submit.
# EASYPARCEL_SUBMIT_PATH=/shipment/submit_orders
# Optional override for tracking if EasyParcel changes the Developer Hub endpoint.
# EASYPARCEL_TRACKING_PATH=/open_api/2026-03/shipment/trackings

# Malaysia Developer Hub app credentials and connected account tokens
EASYPARCEL_MY_CLIENT_ID=*****
EASYPARCEL_MY_CLIENT_SECRET=*****
EASYPARCEL_MY_REDIRECT_URI="*****"
EASYPARCEL_MY_ACCESS_TOKEN="*****"
EASYPARCEL_MY_REFRESH_TOKEN="*****"
EASYPARCEL_MY_TOKEN_EXPIRES_AT=""
EASYPARCEL_MY_SENDER_EMAIL="*****"

# Singapore Developer Hub app credentials and connected account tokens
EASYPARCEL_SG_CLIENT_ID=*****
EASYPARCEL_SG_CLIENT_SECRET=*****
EASYPARCEL_SG_REDIRECT_URI=*****
EASYPARCEL_SG_ACCESS_TOKEN=*****
EASYPARCEL_SG_REFRESH_TOKEN=*****
EASYPARCEL_SG_TOKEN_EXPIRES_AT=
EASYPARCEL_SG_SENDER_EMAIL=*****
